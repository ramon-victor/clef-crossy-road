{
  "name": "clef-crossy-road",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramon-victor/clef-crossy-road.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/fetch-assets.mjs && pnpm --filter @ccr/desktop dev",
    "dev:desktop": "node scripts/fetch-assets.mjs && pnpm --filter @ccr/desktop tauri dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "bench": "node --env-file-if-exists=.env apps/bench/src/cli.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
