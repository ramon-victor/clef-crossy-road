{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clef Crossy Road",
  "version": "0.1.0",
  "identifier": "dev.ccr.clefcrossyroad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clef Crossy Road",
        "width": 440,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "controls",
        "title": "Clef Crossy Road · Controls",
        "width": 320,
        "height": 800,
        "minWidth": 320,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "decisions",
        "title": "Clef Crossy Road · Decisions",
        "width": 360,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ws://localhost:5173 http://localhost:5173 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
